# Copiar a .env (nunca subir .env al repositorio).
# Generar claves con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/inpe-devsecops
# Mínimo 32 caracteres
JWT_SECRET=
# 32 bytes en base64: clave AES-256-GCM del texto libre sensible (fundamentos de solicitudes y decisiones)
DATA_KEY=
# Orígenes permitidos, separados por coma
CORS_ORIGIN=http://localhost:5173
# Cada cuántos minutos se reevalúan los umbrales de alerta (0 = desactivado)
ALERT_JOB_INTERVAL_MIN=15
# Solo para el seed en local/DEV: contraseña inicial de los usuarios ficticios (mínimo 12 caracteres)
SEED_PASSWORD=
# Solo para las pruebas: servidor MongoDB donde se crean bases desechables (inpe_test_*)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017
