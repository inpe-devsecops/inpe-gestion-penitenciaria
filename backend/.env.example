# Copiar a .env (nunca subir .env al repositorio).
# Generar claves con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/inpe-devsecops
# Mínimo 32 caracteres
JWT_SECRET=
# 32 bytes en base64: clave AES-256-GCM para campos sensibles (RNF01)
DATA_KEY=
# 32 bytes en base64: clave HMAC para el índice ciego del documento (RNF02)
HMAC_KEY=
# Orígenes permitidos, separados por coma
CORS_ORIGIN=http://localhost:5173
# Solo para el script de carga en local/DEV: contraseña inicial de los usuarios simulados
SEED_PASSWORD=
